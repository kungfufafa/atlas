{
  "name": "atlas",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/platform/*",
    "packages/*"
  ],
  "scripts": {
    "atlas:channel-loop": "bun run scripts/channel-loop-harness/run.ts",
    "atlas:harness-eval": "bun run scripts/harness-eval/run.ts",
    "atlas:live-human-e2e": "bun run scripts/live-human-e2e/run.ts",
    "atlas:production-readiness": "bun run scripts/production-readiness/run.ts",
    "atlas:release-gate": "bun run scripts/release-gate/index.ts",
    "build": "bun run --workspaces --if-present build",
    "build:docs": "bun run --cwd docs/website build",
    "check": "ultracite check",
    "dev": "bun run dev:web",
    "dev:automation": "bun run --filter @atlas/automation dev",
    "dev:cli": "bun run apps/cli/src/index.ts",
    "dev:discord": "bun run --filter @atlas/discord dev",
    "dev:docs": "bun run --cwd docs/website dev",
    "dev:mobile": "bun run --filter @atlas/mobile start",
    "dev:server": "bun run apps/server/src/dev.ts",
    "dev:telegram": "bun run --filter @atlas/telegram dev",
    "dev:web": "bun run --filter @atlas/web dev",
    "dev:whatsapp": "bun run --filter @atlas/whatsapp dev",
    "doctor": "npx react-doctor@latest",
    "fix": "ultracite fix",
    "postinstall": "bun install --cwd docs/website",
    "pm2:deploy": "bash scripts/pm2-deploy.sh",
    "pm2:logs": "bun x pm2 logs atlas",
    "pm2:stop": "bun x pm2 stop atlas",
    "prepare": "husky",
    "preview:docs": "bun run --cwd docs/website preview",
    "release-gate": "bun run scripts/release-gate/index.ts",
    "start": "bun run apps/server/dist/index.js",
    "test": "bun run scripts/run-unit-tests.ts",
    "test:heavy": "bun test ./apps/server/src/services/browser-session-service.test.ts ./packages/core/src/artifact-preview/office-worker.test.ts",
    "test:smoke": "bun test ./scripts/channel-loop-harness/channel-loop-harness.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "view:cassettes": "bun run apps/server/src/testing/cassettes/serve.ts"
  },
  "overrides": {
    "libsignal": "6.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hugeicons-react": "^0.4.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "ultracite": "7.10.7"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "patchedDependencies": {
    "libsignal@6.0.0": "patches/libsignal@6.0.0.patch"
  }
}
