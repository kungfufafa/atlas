+      join(foreign, "artifacts", "nested", "selected.txt"),
+      join(profile, "artifacts", "hardlinked.txt")
+    );
+    for (const name of [
+      "artifacts/foreign/nested/selected.txt",
+      "artifacts/linked.txt",
