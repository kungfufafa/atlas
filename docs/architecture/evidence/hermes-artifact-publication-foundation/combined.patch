+        record.outputOrdinal,
+        record.sourcePath,
+        record.filename,
+        record.mimeType,
+        record.sizeBytes,
+        record.sha256,
+        record.sourceEvidence,
+      ];
+    });
+  return JSON.stringify([owner, rows]);
